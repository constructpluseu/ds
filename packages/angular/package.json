{
  "name": "@constructpluseu/angular",
  "version": "1.0.0",
  "description": "Implementação em Angular do Construct+ Design System.",
  "license": "UNLICENSED",
  "keywords": ["construct-plus", "design-system", "angular", "ui-components"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/constructpluseu/ds.git",
    "directory": "packages/angular"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/fesm2022/constructpluseu-angular.mjs",
  "module": "./dist/fesm2022/constructpluseu-angular.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "esm2022": "./dist/esm2022/constructpluseu-angular.mjs",
      "esm": "./dist/esm2022/constructpluseu-angular.mjs",
      "default": "./dist/fesm2022/constructpluseu-angular.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "ng-packagr -p ng-package.json && node scripts/copy-styles.mjs",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "@angular/common": "^18.0.0",
    "@angular/core": "^18.0.0",
    "rxjs": "^7.8.0"
  },
  "dependencies": {
    "@constructpluseu/tokens": "workspace:*",
    "tslib": "^2.7.0"
  },
  "devDependencies": {
    "@angular/common": "^18.2.8",
    "@angular/compiler": "^18.2.8",
    "@angular/compiler-cli": "^18.2.8",
    "@angular/core": "^18.2.8",
    "@angular/platform-browser": "^18.2.8",
    "@angular/platform-browser-dynamic": "^18.2.8",
    "@types/jest": "^29.5.13",
    "@types/jest-axe": "^3.5.9",
    "jest": "^29.7.0",
    "jest-axe": "^11.0.0",
    "jest-preset-angular": "^14.2.4",
    "ng-packagr": "^18.2.1",
    "rxjs": "^7.8.1",
    "typescript": "~5.5.4",
    "zone.js": "^0.14.10"
  }
}
