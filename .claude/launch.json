{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nextjs-demo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "nextjs-demo", "start"],
      "port": 3000
    },
    {
      "name": "docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "docs", "dev"],
      "port": 3100
    },
    {
      "name": "docs-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "apps/docs/out", "-l", "3200"],
      "port": 3200
    }
  ]
}
